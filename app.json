{
  "expo": {
    "name": "Hebbian",
    "slug": "digital-brain",
    "version": "1.0.0",
    "scheme": "digitalbrain",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#131318",
    "icon": "./public/icons/icon-512.png",
    "plugins": [
      "./scripts/with-windows-cmake-paths.cjs",
      "expo-asset",
      ["expo-image-picker", {
        "cameraPermission": "Use a câmera para adicionar fotos ao perfil, exercícios e treinos.",
        "photosPermission": "Selecione fotos para o perfil, exercícios e treinos.",
        "microphonePermission": false
      }]
    ],
    "ios": {
      "bundleIdentifier": "app.digitalbrain.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "Use a câmera para adicionar fotos ao perfil, exercícios e treinos.",
        "NSPhotoLibraryUsageDescription": "Selecione fotos para o perfil, exercícios e treinos."
      }
    },
    "android": {
      "package": "app.digitalbrain.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./public/icons/icon-512-maskable.png",
        "backgroundColor": "#131318"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "extra": {
      "eas": {
        "projectId": "66424f93-972c-4555-8d64-a246f3c43220"
      }
    },
    "owner": "digital-brain-team"
  }
}
