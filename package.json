{
  "name": "digital_brain",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "./src/expo/index.ts",
  "scripts": {
    "postinstall": "node scripts/bundle-fonts.mjs",
    "start": "node scripts/expo.mjs start",
    "dev": "node scripts/expo.mjs start --web --port 5190",
    "android": "node scripts/expo.mjs start --android",
    "ios": "node scripts/expo.mjs start --ios",
    "build": "tsc -p tsconfig.app.json && node scripts/expo.mjs export --platform web && node scripts/build-service-worker.mjs",
    "build:native": "node scripts/expo.mjs export --platform ios --platform android --output-dir dist-native",
    "lint": "eslint .",
    "test": "node --import ./tests/register.mjs --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "preview": "serve --single dist"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@supabase/supabase-js": "^2.119.2",
    "@tanstack/react-query": "^5.108.2",
    "expo": "^58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-file-system": "~58.0.14",
    "expo-sharing": "~58.0.23",
    "expo-web-browser": "~58.1.0",
    "lucide-react": "^1.77.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-router-dom": "^7.18.6",
    "workbox-build": "^7.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "serve": "^14.2.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
